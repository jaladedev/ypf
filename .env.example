# Copy to .env.local and fill in. Never commit real values.

# Supabase project (local: run `npx supabase start`, then `npx supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used for auth redirects and metadata.
# Local: http://localhost:3000   Production: your Vercel/custom domain
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google sign-in (read by supabase/config.toml for local dev; for a hosted
# project set these in Supabase Dashboard > Authentication > Providers > Google)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Email (Resend). Without a key, emails are skipped and logged (fine for local dev).
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. "YPF <no-reply@yourdomain.org>"
EMAIL_FROM=
# Comma-separated; receive contact-form messages and new membership applications
ADMIN_NOTIFY_EMAIL=

# Phase 6
# Secret for the daily maintenance cron (Vercel sends it automatically as a Bearer token
# once CRON_SECRET is set in the project's environment variables). Use a long random string.
CRON_SECRET=
# Optional: any random string; mixed into the hashed client address used for rate limiting.
RATE_LIMIT_SALT=
